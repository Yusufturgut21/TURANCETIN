# ============================================================
# TURANÇETİN — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# ASLA GitHub'a yüklemeyin (.gitignore zaten engeller).
# ============================================================

# MongoDB Atlas connection string
# Örnek: mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/turancetin?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth / Auth.js gizli anahtar (uzun rastgele metin)
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# Yerel geliştirmede:
NEXTAUTH_URL=http://localhost:3000
# Production'da (Vercel):
# NEXTAUTH_URL=https://www.turancetin.com.tr

# Site adresi (SEO, sitemap, Open Graph için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İsteğe bağlı varsayılan iletişim (Site Ayarlarından da yönetilir)
NEXT_PUBLIC_WHATSAPP_NUMBER=905550000000
NEXT_PUBLIC_PHONE=+90 555 000 00 00

# Seed / create-admin için (isteğe bağlı)
ADMIN_EMAIL=admin@turancetin.com
ADMIN_PASSWORD=Admin123!
